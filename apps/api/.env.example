# Copy this file to apps/api/.env for local runs.
# On GitHub / Render, set these as secrets instead (never commit .env).

# --- Required ---
# Free Postgres from neon.tech (Connect -> turn OFF "Connection pooling" -> copy)
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# --- AI (pick one) ---
# gemini = free (aistudio.google.com -> Get API key)
# claude = paid (console.anthropic.com)
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Models (optional; defaults shown). Run `npm run ai:check` to see what your key can use.
GEMINI_SCORE_MODEL=gemini-flash-lite-latest
GEMINI_TAILOR_MODEL=gemini-flash-latest
# Used when a model is overloaded or removed. Leave out for the defaults; empty turns backups off.
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
CLAUDE_SCORE_MODEL=claude-haiku-5-5
CLAUDE_TAILOR_MODEL=claude-sonnet-5-5
# Wait between Gemini calls (ms) to stay under the free per-minute limit
GEMINI_MIN_INTERVAL_MS=4500

# --- Dashboard ---
# Any long random string (min 16 chars). You type it into the dashboard to log in.
DASHBOARD_TOKEN=
# Where the dashboard runs (comma-separated) for CORS
WEB_ORIGIN=http://localhost:5173

# --- Optional job sources (leave empty to skip) ---
# serpapi.com (Google Jobs: includes LinkedIn, Bayt, GulfTalent listings)
SERPAPI_KEY=
GOOGLE_MAX_SEARCHES_PER_RUN=3
# jooble.org/api/about (covers the UAE)
JOOBLE_API_KEY=
# developer.adzuna.com (remote jobs in other countries)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Telegram morning message (optional) ---
# Create a bot with @BotFather, send it "hi", then run: npm run telegram:setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=

# Your CV as one-line JSON. If empty, cv/base-cv.json is used.
BASE_CV_JSON=
