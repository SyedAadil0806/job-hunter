generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Where a job is in the pipeline.
enum JobStatus {
  NEW      // collected, not scored yet
  FILTERED // dropped by the cheap keyword/location filter
  SCORED   // scored by Claude
  READY    // tailored CV + cover letter made, waiting for you to apply
  APPLIED  // you applied (see Application)
  SKIPPED  // you chose to skip it
}

/// What happened after you applied.
enum ApplicationStatus {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
  WITHDRAWN
}

model Job {
  id            String    @id @default(cuid())
  source        String // remotive, remoteok, arbeitnow, adzuna, jooble, google
  externalId    String
  /// normalized "company|title" so the same job from two sites is stored once
  dedupeKey     String    @unique
  title         String
  company       String
  location      String
  isRemote      Boolean   @default(false)
  url           String
  description   String
  salary        String?
  tags          String[]
  postedAt      DateTime?
  status        JobStatus @default(NEW)
  filterReason  String?

  score         Int?
  scoreReason   String?
  matchedSkills String[]
  missingSkills String[]
  redFlags      String[]
  scoredAt      DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cvVersions    CvVersion[]
  application   Application?

  @@unique([source, externalId])
  @@index([status, score])
  @@index([createdAt])
}

model CvVersion {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// the tailored CV as structured JSON (same shape as cv/base-cv.json)
  content     Json
  coverLetter String
  pdf         Bytes
  model       String
  createdAt   DateTime @default(now())

  applications Application[]

  @@index([jobId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String            @unique
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvVersionId String?
  cvVersion   CvVersion?        @relation(fields: [cvVersionId], references: [id], onDelete: SetNull)
  status      ApplicationStatus @default(APPLIED)
  notes       String?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

/// One row per pipeline run, so you can see what happened each day.
model PipelineRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  collected   Int       @default(0)
  newJobs     Int       @default(0)
  filtered    Int       @default(0)
  scored      Int       @default(0)
  tailored    Int       @default(0)
  errors      String[]
}
