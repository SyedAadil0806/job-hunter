{
  "name": "@job-hunter/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "prisma db push --skip-generate && node dist/main.js",
    "start:dev": "prisma generate && tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "pipeline": "npm run build && node dist/pipeline/run.js",
    "pipeline:collect": "npm run build && node dist/pipeline/run.js --only=collect",
    "ai:check": "npm run build && node dist/pipeline/ai-check.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/jobs/filter.test.ts src/cv/tailor.merge.test.ts src/ai/ai.service.test.ts src/sources/remote-flags.test.ts src/jobs/liveness.service.test.ts src/pipeline/notify.test.ts src/pipeline/run-now.service.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@google/genai": "^2.32.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pdfkit": "^0.17.2",
    "prisma": "~6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.2",
    "tsc-watch": "^7.1.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
